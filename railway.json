{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "volumes": [
      {
        "name": "swiftpay-data",
        "mountPath": "/data"
      }
    ],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "ENVIRONMENT": "production",
        "DATABASE_URL": "sqlite+aiosqlite:////data/paybot.db",
        "PYTHON_BACKEND_URL": "https://api.swiftpay.site",
        "FRONTEND_URL": "https://swiftpay.site",
        "PUBLIC_CHECKOUT_HOST": "https://swiftpay.site",
        "VITE_API_URL": "https://api.swiftpay.site",
        "SWIFTPAY_MODE": "production",
        "SWIFTPAY_BASE_URL": "https://api.pay.live.swiftpay.ph",
        "SMTP_FROM_NAME": "SwiftPay",
        "SMTP_PORT": "465"
      }
    }
  }
}
