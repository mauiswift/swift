## Example production environment variables for paybot backend
# Copy this to `.env.production` locally or set these in your deployment platform.

# Core
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@host:5432/paybot
JWT_SECRET_KEY=replace-with-a-very-long-secret
PYTHON_BACKEND_URL=https://api.swiftpay.site
PUBLIC_CHECKOUT_HOST=https://swiftpay.site
FRONTEND_URL=https://swiftpay.site

# Telegram
TELEGRAM_MINI_APP_URL=https://api.swiftpay.site/mini-app
TELEGRAM_BOT_TOKEN=123456:ABCDEF-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
GOOGLE_CLIENT_ID=
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_BOT_OWNER_ID=123456789

# SwiftPay
SWIFTPAY_ACCESS_KEY=replace-me
SWIFTPAY_SECRET_KEY=replace-me
SWIFTPAY_MODE=production
SWIFTPAY_BASE_URL=https://api.pay.live.swiftpay.ph
SWIFTPAY_CALLBACK_URL=https://api.swiftpay.site/api/v1/webhooks/swiftpay

# Magpie
MAGPIE_API_KEY=replace-me
MAGPIE_SECRET_KEY=replace-me
MAGPIE_BASE_URL=https://pay.magpie.im
MAGPIE_MODE=production
MAGPIE_CALLBACK_URL=https://api.swiftpay.site/api/v1/webhooks/magpie

# Xendit (if used)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_SECRET=
XENDIT_CALLBACK_URL=

# Cloudflare Turnstile (optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Email / Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=your-hostinger-app-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=SwiftPay

# Build-time Vite front-end vars (set in build env)
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_API_BASE_URL=https://api.swiftpay.site/api/v1

# Deployment helpers
INITIALIZE_DEMO_DATA=0
DISABLE_BACKGROUND_TASKS=0

# DO NOT COMMIT SECRETS
