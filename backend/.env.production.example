## Example production environment variables for paybot backend
# Copy this to `.env.production` locally or set these in your deployment platform.

# Core
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@db-host:5432/paybot
JWT_SECRET_KEY=replace-with-a-very-long-secret
PYTHON_BACKEND_URL=https://swiftpay.site

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDEF-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_ADMIN_IDS=123456789

# SwiftPay (sandbox credentials provided)
SWIFTPAY_ACCESS_KEY=0F2271D49BC04F6DA8BE92E99C39E617
SWIFTPAY_SECRET_KEY=268EFCA56CE54677A21C7987BF1D33E4
SWIFTPAY_MODE=sandbox
SWIFTPAY_BASE_URL=https://api.swiftpay.ph
SWIFTPAY_CALLBACK_URL=https://swiftpay.site/api/v1/swiftpay/callback

# Xendit (if used)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_SECRET=
XENDIT_CALLBACK_URL=

# Cloudflare Turnstile (optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Build-time Vite front-end vars (set in build env)
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_API_BASE_URL=https://swiftpay.site/api/v1

# Deployment helpers
INITIALIZE_DEMO_DATA=0
DISABLE_BACKGROUND_TASKS=0### Copy this to .env.production and fill values. Do NOT commit secrets.

# App
BACKEND_URL=https://your-production-domain.com
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET_KEY=replace_with_secure_random_value

# Telegram
TELEGRAM_BOT_TOKEN=8303730706:AAHhG0ox4Evwn7LxvLdUbylCvF5qZOzoorI
TELEGRAM_ADMIN_IDS=

# Maya Manager Checkout (Maya Manager v1)
MAYA_SECRET_KEY=
MAYA_MODE=live
MAYA_BASE_URL=https://pg.paymaya.com/p3/pay
MAYA_WEBHOOK_SECRET=

# Maya Business API (card payments / Business API)
MAYA_BUSINESS_API_KEY=
MAYA_BUSINESS_SECRET_KEY=
MAYA_BUSINESS_MODE=live
MAYA_BUSINESS_BASE_URL=https://api.paymaya.com

# Other production secrets
# DO NOT COMMIT
