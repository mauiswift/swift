# ========== DATABASE ==========
DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_PUBLIC_URL=postgresql://user:password@public-host:port/dbname

# ========== JWT & AUTH ==========
JWT_SECRET_KEY=your-super-secret-key-here-min-32-chars
ADMIN_USER_EMAIL=admin@swiftpay.ph
ADMIN_USER_PASSWORD=SecureAdminPassword123!
TELEGRAM_BOT_OWNER_ID=YOUR_TELEGRAM_ID

# ========== TELEGRAM BOT ==========
TELEGRAM_BOT_TOKEN=123456:ABCDefGHIjklmNoPqrsTuvWxyz
TELEGRAM_BOT_USERNAME=SwiftPayPHBot
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile
# Keep the secret key server-side; the site key is safe to expose in the frontend build.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_ALLOWED_HOSTNAMES=swiftpay.site,kr.swiftpay.site,localhost,127.0.0.1
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEy2mGn-OGXXID21

# ========== SWIFTPAY GATEWAY (Philippine Local Payments) ==========
# Supports: GCash, Maya, Bank Transfer, QR Code
SWIFTPAY_ACCESS_KEY=your_access_key
SWIFTPAY_SECRET_KEY=your_secret_key
SWIFTPAY_MODE=production
SWIFTPAY_BASE_URL=https://api.pay.live.swiftpay.ph
# Optional override when the provider account-balance route differs from /api/account/balance.
SWIFTPAY_BALANCE_URL=
SWIFTPAY_CALLBACK_URL=https://api.swiftpay.site/api/v1/webhooks/swiftpay

# ========== COINS.PH PRO SPOT TRADING ==========
# Use a trading-only key; do not enable withdrawals.
COINSP_API_KEY=
COINSP_API_SECRET=
COINSP_API_BASE_URL=https://api.pro.coins.ph
COINSP_USDT_PHP_SYMBOL=USDTPHP

# ========== MAGPIE (Alipay & WeChat Pay) ==========
# Supports: Alipay, WeChat Pay (Chinese market)
MAGPIE_PUBLIC_KEY=your_magpie_public_key
MAGPIE_API_KEY=your_magpie_api_key
MAGPIE_SECRET_KEY=your_magpie_secret_key
MAGPIE_MODE=production
MAGPIE_BASE_URL=https://api.magpie.ph
MAGPIE_CALLBACK_URL=https://api.swiftpay.site/api/v1/webhooks/magpie

# ========== APPLICATION ==========
ENVIRONMENT=production
PUBLIC_CHECKOUT_HOST=https://swiftpay.site
KRW_CHECKOUT_HOST=https://kr.swiftpay.site
PYTHON_BACKEND_URL=https://api.swiftpay.site
FRONTEND_URL=https://swiftpay.site

# ========== SMTP (Hostinger example) ==========
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=your-hostinger-app-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=SwiftPay
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ========== SMS GATEWAY ==========
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_key
SMS_ENABLE_NOTIFICATIONS=true
