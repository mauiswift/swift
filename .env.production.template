# --- Core Platform Settings ---
ENVIRONMENT=production
JWT_SECRET_KEY=             # Generate with: openssl rand -hex 32
DATABASE_URL=               # Provided by 'railway add postgres'

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=         # From @BotFather
TELEGRAM_BOT_USERNAME=      # e.g., MyStoreBot
TELEGRAM_BOT_OWNER_ID=      # Your numeric Telegram ID

# --- SwiftPay API (For processing payments & disbursements) ---
SWIFTPAY_ACCESS_KEY=
SWIFTPAY_SECRET_KEY=
SWIFTPAY_MODE=production
SWIFTPAY_BASE_URL=https://api.pay.live.swiftpay.ph

# --- Magpie (International payments) ---
MAGPIE_API_KEY=
MAGPIE_SECRET_KEY=
MAGPIE_BASE_URL=https://pay.magpie.im
MAGPIE_MODE=production
MAGPIE_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/magpie

# --- Xendit API (Optional) ---
XENDIT_SECRET_KEY=

# --- Public URLs ---
PUBLIC_CHECKOUT_HOST=https://swiftpay.site
FRONTEND_URL=https://swiftpay.site
PYTHON_BACKEND_URL=https://api.swiftpay.site

# --- Frontend (Vite) ---
VITE_API_URL=https://api.swiftpay.site
VITE_TELEGRAM_BOT_USERNAME=@QRPHBOT
VITE_TURNSTILE_SITE_KEY=    # Optional: For CAPTCHA protection

# --- Email / Hostinger SMTP ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@swiftpay.site
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@swiftpay.site
SMTP_FROM_NAME=SwiftPay
