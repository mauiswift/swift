# --- Core Platform Settings ---
ENVIRONMENT=production
JWT_SECRET_KEY=             # Generate with: openssl rand -hex 32
DATABASE_URL=               # Provided by 'railway add postgres'

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=         # From @BotFather
TELEGRAM_BOT_USERNAME=      # e.g., MyStoreBot
TELEGRAM_BOT_OWNER_ID=      # Your numeric Telegram ID

# --- SwiftPay API (For processing payments & disbursements) ---
SWIFTPAY_ACCESS_KEY=
SWIFTPAY_SECRET_KEY=
SWIFTPAY_MODE=production
SWIFTPAY_BASE_URL=https://api.pay.live.swiftpay.ph

# --- Xendit API (Optional) ---
XENDIT_SECRET_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=               # Your Railway public URL (e.g., https://xxx.up.railway.app)
VITE_TELEGRAM_BOT_USERNAME= # Same as TELEGRAM_BOT_USERNAME
VITE_TURNSTILE_SITE_KEY=    # Optional: For CAPTCHA protection

# --- Email / Hostinger SMTP ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=your-hostinger-app-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=SwiftPay
FRONTEND_URL=https://yourdomain.com
